# Estas variables se configuran en Vercel (Settings → Environment Variables). No se guardan en el código.

# Las 3 de Supabase las pone Vercel solo al conectar la integración de Supabase (paso 3 del README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# La única que se copia a mano: token de la Private App de HubSpot.
HUBSPOT_TOKEN=
